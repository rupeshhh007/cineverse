# Cineverse Environment Configuration

# Gemini API Key (Server-side only — never expose to client)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Selection (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Session Secret (Optional in local development; REQUIRED in production)
SESSION_SECRET=

# External PostgreSQL Connection URL (Optional: omit to use embedded zero-setup PGlite)
# DATABASE_URL=postgresql://user:password@localhost:5432/cineverse
